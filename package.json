{
  "name": "liquid-glass-filter",
  "version": "1.0.0",
  "description": "Physics-based liquid glass refraction for the web: a headless engine plus a tiny attach/update/destroy API. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite demo/",
    "build": "tsc -p tsconfig.json && vite build",
    "build:demo": "tsc -p tsconfig.json && vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.core.json"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^22.20.5",
    "lit": "^3.3.1",
    "tweakpane": "^4.0.5",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.6"
  }
}
