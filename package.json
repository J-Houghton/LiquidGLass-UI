{
  "name": "liquid-glass-filter",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/liquid-glass.cjs.js",
  "module": "./dist/liquid-glass.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/liquid-glass.es.js",
      "require": "./dist/liquid-glass.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite demo/",
    "build": "tsc -p tsconfig.json && vite build",
    "build:demo": "tsc -p tsconfig.json && vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "canvas": "^3.2.0"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "lit": "^3.3.1",
    "tweakpane": "^4.0.5",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.6"
  }
}
