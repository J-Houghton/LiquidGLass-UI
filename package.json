{
  "name": "liquid-glass-filter",
  "version": "2.0.0",
  "description": "Physics-based liquid glass refraction for the web: a headless engine plus a tiny attach/update/destroy API. Zero dependencies.",
  "keywords": [
    "liquid-glass",
    "glass",
    "refraction",
    "backdrop-filter",
    "svg-filter",
    "displacement-map",
    "web-components",
    "headless"
  ],
  "homepage": "https://github.com/J-Houghton/LiquidGLass-UI#readme",
  "bugs": {
    "url": "https://github.com/J-Houghton/LiquidGLass-UI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J-Houghton/LiquidGLass-UI.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite demo/",
    "build": "tsc -p tsconfig.json && vite build",
    "build:demo": "tsc -p tsconfig.json && vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.core.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "tweakpane": "^4.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.1.0"
  }
}
