        "width": "100%",
        "x": "0",
        "y": "0",
      },
      "tag": "feImage",
    },
    {
      "attrs": {
        "data-dyn": "1",
        "data-role": "blur",
        "in": "refr",
        "result": "blurred",
        "stdDeviation": "0.20",
      },
      "tag": "feGaussianBlur",
    },
  ],
  "tag": "filter",
}
`;

